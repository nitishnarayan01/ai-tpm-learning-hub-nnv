  "cards": [
    {
      "dot": "cyan",
      "title": "Why Guardrails Sit Outside the Model",
      "items": [
        "A system prompt is just another input the model weighs",
        "A guardrail is code that runs whatever the model decided"
      ]
    },
    {
      "dot": "rose",
      "title": "TPM Questions",
      "items": [
        "Are safety rules enforced by guardrails, or only by the prompt?",
        "Do output checks catch PII before the user sees it?",
        "Are retrieved (RAG) documents checked for injected instructions?"
      ]
    }
  ]
}
