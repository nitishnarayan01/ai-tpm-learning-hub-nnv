  "cards": [
    {
      "dot": "amber",
      "title": "The Problem",
      "items": [
        "45 minutes went to choosing a vector DB vendor",
        "Nobody asked about chunking, evals, cost, or guardrails"
      ]
    },
    {
      "dot": "cyan",
      "title": "Six Review Dimensions",
      "items": [
        "1 Data & Retrieval: Support Docs, Chunk + Embed, Vector DB, Reranker",
        "2 Model & Prompting: LLM",
        "3 Pipeline Design: Support Agent, Ticket Tool",
        "4 Operations: Guardrails, Tracing, Eval Golden Set",
        "5 Cost & Capacity: API Gateway (rate limits), Cost Tracking",
        "6 Security & Governance: API Gateway (auth), Audit Log"
      ]
    },
    {
      "dot": "emerald",
      "title": "How to Use This Diagram",
      "items": [
        "Click a component, then Downstream to see what a gap there affects",
        "Treat \"we haven't decided yet\" as a found gap, not a failure"
      ]
    },
    {
      "dot": "rose",
      "title": "TPM Questions",
      "items": [
        "Which items are addressed, which are gaps, and who closes each?",
        "Is the review early enough to still change the design?"
      ]
    }
  ]
}
